FROM ghcr.io/benoitc/gunicorn:latest

LABEL maintainer="Munadi.org"
LABEL name="munadi/web-server"
LABEL summary="Web server for https://munadi.org"
LABEL distribution-scope="public"
LABEL cpe="cpe:/o:benoitc:gunicorn:25:3:"

LABEL com.redhat.component="munadi-org-web-server"

LABEL org.opencontainers.image.authors="Abou Abbad, Hasan Esa"
LABEL org.opencontainers.image.url="https://gitlab.com/munadi/munadi/container_registry"
LABEL org.opencontainers.image.source="https://gitlab.com/munadi/munadi"
LABEL org.opencontainers.image.version="26.11"
LABEL org.opencontainers.image.revision="3"
LABEL org.opencontainers.image.vendor="Munadi.org"
LABEL org.opencontainers.image.licenses="AGPL-3.0, GPL-3.0 or LGPL"
LABEL org.opencontainers.image.title="Munadi web server image"
LABEL org.opencontainers.image.description="Web server image for https://munadi.org"
LABEL org.opencontainers.image.base.name="ghcr.io/benoitc/gunicorn:latest"

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY --chown=gunicorn:gunicorn . .

CMD ["munadi_org:app", "-w", "2", "-b", "0.0.0.0:8000"]

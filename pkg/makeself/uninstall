#!/bin/bash

set -e
set -o pipefail

declare -i _nocleanup=0   # bool
declare -i _debug=${MUNADI_DEBUG:-0}  # bool
declare -i _noask=0       # bool
declare -i _noexec=0      # bool
declare -i _noscript=0    # bool
declare -i _priv=0        # bool
declare -i _quiet=0       # bool
declare -i _sane=1        # bool
declare -i _verbose=0     # bool
(( _debug )) && _verbose=1

_script=uninstall
_arch=x86_64
_errout="${TMPROOT:-/tmp}/munadi-stderr.$RANDOM"
_logfile="${TMPROOT:-/tmp}/munadi-$_script-$RANDOM.log"
_v_args=''
_ver=26.06
_trapexec=( 'rm -f "$_errout"' )

trap 'for handler in "${_trapexec[@]}"; do eval "$handler"; done' \
  ERR EXIT ABRT INT QUIT SEGV TERM

log() {
  echo -e "$(date --rfc-3339 ns):munadi:$_script:$*" &>> "$_logfile"
}

debug_print()
{
  if (( _debug )); then
    echo -e "\e[0;34mmunadi:$_script:debug::\t$*\e[0;m" >&2
    log "debug:: $*"
  fi
}

error_print()
{
  if (( ! _quiet )); then
    echo -e "\e[0;31mmunadi:$_script:error::\t$*\e[0;m" >&2
  fi
  log "error:: $*"
}

warn_print()
{
  if (( ! _quiet )); then
    echo -e "\e[0;33mmunadi:$_script:warn::\t$*\e[0;m" >&2
  fi
  log "warn:: $*"
}

info_print()
{
  if (( _verbose )); then
    echo -e "munadi:$_script:info::\t$*"
  fi
  log "info:: $*"
}

log_cmd()
{
  while read -e line; do
    info_print "$line"
  done
}

show_help()
{
  echo "Usage:"
  echo "$_script [-h] [-ncq] [-ncv] [-cqs] [-csvy]"
  echo "$_script [--help] [--nocleanup --noexec --quiet] [--nocleanup --noexec --verbose] [--quiet --nocleanup --noscript] [--nocleanup --noscript --verbose --assumeyes]"
  echo
  echo Options:
  echo "  -h, --help        Shows this help message"
  echo "  -N  --nocleanup   Keep app config and data"
  echo "  -n, --noexec      Do not execute. Good for checking eligibility."
  echo "                    With '-s' do minimal checks only."
  echo "  -q, --quiet       Show less messages, even suppress usual output"
  echo "                    (implies -y)"
  echo
  echo "  -s, --noscript    Skip running pre- and post-$_script routines"
  echo "  -y, --assumeyes   Assume yes on confirmation"
  echo "  -v, --verbose     Show more messages. '-q' will have no effect"
  echo
  echo "  MUNADI_DEBUG=1    Show debug messages. Implies '-v'"
  echo
}

_trapexec+=( 'warn_print "A log file is available at "$_logfile""' )

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Flag parsing

  while (( ${#@} )); do
    case "$1" in
      --assumeyes) _noask=1;;
      --help) show_help; exit 0;;
      --nocleanup) _nocleanup=1;;
      --noexec) _noexec=1;;
      --noscript) _noscript=1;;
      --quiet) _quiet=1;;
      --verbose) _verbose=1;;
      -*)
        OPTIND=1
        while getopts hNnqsvy- opt; do
          case $opt in
            h) show_help; exit 0;;
            N) _nocleanup=1;;
            n) _noexec=1;;
            q) _quiet=1;;
            s) _noscript=1;;
            v) _verbose=1;;
            y) _noask=1;;
            -) break;;
            \?) show_help; exit 1;;
          esac
        done
        ;;
      *) error_print "illegal option: $1"; show_help; exit 1;;
    esac
    shift
  done

  (( _quiet = _quiet & ! _verbose )) || :
  (( _quiet | _noexec )) && _noask=1
#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Pre-uninstall routines

  # Do a pre-uninstall check in case environment changed or because script is
  # running standalone.

  #+++++++++++++++++++++++++++++++++++++++++++++++++++
  # Test if required programs are available on the system
  debug_print 'Checking if required programs are available...'
  if hash pkill rm rmdir sed xdg-desktop-menu xdg-icon-resource 2>"$_errout"
  then
    debug_print "\n$(hash -t pkill rm rmdir sed \
      xdg-desktop-menu xdg-icon-resource)"
  else
    _sane=0; error_print "$(<"$_errout")"
  fi
  _trapexec+=( 'hash -r' )
  #---------------------------------------------------

  #+++++++++++++++++++++++++++++++++++++++++++++++++++
  # Exit if one or more sanity checks fail

  if (( _sane )); then
    info_print 'All checks succeeded.'
  else
    error_print 'Pre-check failed!'
    exit 1
  fi
  #---------------------------------------------------

  #+++++++++++++++++++++++++++++++++++++++++++++++++++
  # Know what EUID we are. Also detect additional installations

  debug_print 'Checking UID and GID...'
  debug_print "Effective UID is $EUID ($USER)"
  if (( EUID == 0 )); then
    warn_print 'Script is running with superuser privilege.'
    _prefix=/opt/munadi
    _priv=1
    # Check all user installations
    for home in /home/* ; do
      debug_print "Checking $home/.local/libexec/munadi/munadi.version ..."
      _old_ver=$(sed -n 's/^_ver=//p' \
                "$home/.local/libexec/munadi/munadi.version" 2>/dev/null || _old_ver='')
      if [[ -z "$_old_ver" ]]; then
        debug_print "Earlier installation not detected in $home."
      else
        info_print \
        "Skipping another installation of Munadi $_old_ver under $home/.local ."
        info_print "Use regular privilege to $_script it."
      fi
    done
  else
    info_print 'Script is running with normal privilege.'
    _prefix="$HOME/.local"
    _priv=0
    # Check system-wide installation
    debug_print "Checking /opt/munadi/libexec/munadi/munadi.version ..."
    _old_ver=$(sed -n 's/^_ver=//p' \
                  /opt/munadi/libexec/munadi/munadi.version 2>/dev/null || true)
    if [[ -z "$_old_ver" ]]; then
      debug_print "Earlier installation not detected in /opt/munadi"
    else
      info_print \
        "Skipping another installation of Munadi $_old_ver at /opt/munadi."
      info_print "Use superuser privilege to $_script it."
    fi
  fi
  #---------------------------------------------------

  #+++++++++++++++++++++++++++++++++++++++++++++++++++
  # Previous installation detection

  debug_print "Checking $_prefix/libexec/munadi/munadi.version ..."
  _old_ver=$(sed -n 's/^_ver=//p' \
                    "$_prefix/libexec/munadi/munadi.version" 2>/dev/null || :)
  if [[ -z "$_old_ver" ]]; then
    warn_print "Could not detect previous installation under $_prefix."
    (( _noexec )) && info_print "Exiting cleanly." && exit 0
    warn_print "Continuing anyway."
  else
    info_print \
      "Selecting previous installation of Munadi $_old_ver under $_prefix ."
  fi
  #---------------------------------------------------
#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Confirmation before uninstall

  (( _noscript )) && warn_print "Pre/post scripts won't be executed."

  if (( ! _noask )); then
    warn_print "Munadi $_ver will be ${_script}ed under $_prefix ."
    (( _verbose )) || warn_print "Pass '--verbose' to see ${_script}ed files."

    _trapexec+=( "unset REPLY" )
    unset REPLY
    until [[ $REPLY == [yY] ]]
    do
      read -ep 'Continue? [y/N]: '
      if [[ "$REPLY" == [nN] || -z "$REPLY" ]]; then
        warn_print "Aborting ${_script}ation. Nothing done."; exit 0
      fi
    done
  fi

#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Uninstall routines

#   cd "${0%/*}"

  (( _verbose )) && _v_args=' -v '
  info_print "Uninstalling Munadi $_old_ver from $_prefix ..."
  debug_print 'Uninstall phase in progress...'

  if [[ -d "$_prefix" || -L "$_prefix" ]]; then
    cd "$_prefix" &> >(log_cmd)
    debug_print "====== BEGIN from $(hash -t rm) ======"

    rm -f $_v_args \
      ./bin/munadi \
      ./libexec/munadi/install \
      ./libexec/munadi/munadi.version \
      ./libexec/munadi/uninstall \
      ./share/licenses/munadi/LICENSE &> >(log_cmd) || :

    if (( ! _nocleanup )); then
      rm -f $_v_args \
        "$HOME/.config/autostart/org.munadi.Munadi.desktop" \
        "$HOME/.config/munadi/Munadi.conf" &> >(log_cmd) || :
      rm -rf $_v_args \
        ./share/Munadi/ &> >(log_cmd) || :
    fi

    if (( _priv )); then _data_prefix=/usr; else _data_prefix=.; fi
    rm -f $_v_args \
      $_data_prefix/share/metainfo/org.munadi.Munadi.metainfo.xml \
      $_data_prefix/share/icons/hicolor/scalable/apps/org.munadi.Munadi-symbolic.svg \
      $_data_prefix/share/icons/hicolor/symbolic/apps/org.munadi.Munadi-symbolic.svg \
    &> >(log_cmd) || :

    debug_print "======== END from $(hash -t rm) ======"

    debug_print "====== BEGIN from $(hash -t rmdir) ======"

    rmdir -p $_v_args \
      ./bin/ \
      ./libexec/munadi/ \
      ./share/licenses/munadi/ \
      ./share/metainfo/ \
      /usr/share/metainfo/ \
      /usr/share/icons/hicolor/scalable/apps/ \
      /usr/share/icons/hicolor/symbolic/apps/ &> >(log_cmd)  || :

    if (( ! _nocleanup )); then
      rmdir -p $_v_args \
        ../.config/munadi/ &> >(log_cmd) || :
    fi
    debug_print "======== END from $(hash -t rmdir) ======"
    cd - &> >(log_cmd)
  else
    warn_print \
      "$_prefix doesn't exist, not a directory or a valid symbolic link, or doesn't have sufficient permissions."
    warn_print "Continuing through previous error..."
  fi

  unset -v XDG_DATA_DIRS
  declare -x XDG_UTILS_DEBUG_LEVEL
  _trapexec+=( 'unset -v XDG_UTILS_DEBUG_LEVEL' )

  (( XDG_UTILS_DEBUG_LEVEL = _debug ? 3 : ( _verbose ? 1 : 0 ) )) || :
  debug_print "====== BEGIN from $(hash -t xdg-desktop-menu) ======"
  xdg-desktop-menu uninstall org.munadi.Munadi.desktop &> >(log_cmd)
  debug_print "======== END from $(hash -t xdg-desktop-menu) ======"

  debug_print "====== BEGIN from $(hash -t xdg-icon-resource) ======"
  for size in 16 22 24 32 36 48 64 72 80 96 128 192 256 480 512; do
    xdg-icon-resource uninstall --noupdate --size $size org.munadi.Munadi &> \
                                                                      >(log_cmd)
  done
  xdg-icon-resource forceupdate &> >(log_cmd)
  debug_print "======== END from $(hash -t xdg-icon-resource) ======"
#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Post-uninstall routines

  if (( ! _noscript )); then

    # Terminate all instances of the program
    (( _verbose )) && _v_args=' --echo '
    debug_print "====== BEGIN from $(hash -t pkill) ======"
    pkill $_v_args --exact --signal SIGTERM munadi &> >(log_cmd) || \
      debug_print 'No other instances of munadi found.' && :
    debug_print "======== END from $(hash -t pkill) ======"
  fi
#---------------------------------------------------

warn_print "Munadi $_old_ver ${_script}ed successfully."

exit 0

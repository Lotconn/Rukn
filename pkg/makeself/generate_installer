#!/bin/bash

set -e

# makeself.sh /home/joe/mysoft mysoft.sh "Joe's Nice Software Package" ./setup
# e.g. makeself.sh [args] archive_dir file_name label startup_script [script_args]

VER=26.08
REPO_FILES=('LICENSE' 'pkg/makeself/install'
	'pkg/makeself/uninstall' 'xdg/applications/org.munadi.Munadi.desktop'
	'xdg/icons/' 'xdg/metainfo/org.munadi.Munadi.metainfo.xml')

cd ../../

for file in "${REPO_FILES[@]}"; do
	while read -r gitFilePath; do
		if [[ -n "$gitFilePath" ]]; then
			FILES+=("$gitFilePath")
		fi
	done < <(git ls-files "$file")
done

find "${FILES[@]}" -type f -exec bash -c 'commit_time=$(TZ=UTC0 git log -1 \
  --format=tformat:%cd --date=format:%Y-%m-%dT%H:%M:%SZ "$0");
  [[ -n $commit_time ]] && touch -md $commit_time "$0"' {} \;

trap 'rm -rf /tmp/files/' ERR EXIT ABRT INT QUIT SEGV TERM
mkdir -m 0755 /tmp/files/
cp --parents -prt /tmp/files/ "${FILES[@]}"
cp -prt /tmp/files/ build/Release/munadi
find /tmp/files/ -depth -type d -exec sh -c \
	'touch -r "$0/$(ls -At "$0" | head -n1)" "$0"' {} \;
strip /tmp/files/munadi

cd - >/dev/null
makeself/makeself.sh \
	--header ./makeself-header.sh --sha256 --nomd5 \
	--zstd --complevel 22 \
	--comp-extra "--row-match-finder --ultra --compress-literals" \
	--threads 0 \
	--tar-format posix --tar-extra "
    --numeric-owner --owner 0 --group 0 --mode=go+u,go-w
    --posix --pax-option=exthdr.name=%d/PaxHeaders/%f \
    --pax-option=delete=atime,delete=ctime" \
	/tmp/files Munadi-${VER}.run "Munadi $VER Installer" ./install

exit 0

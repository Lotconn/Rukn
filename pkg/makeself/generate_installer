#!/bin/bash

set -e

#
#	Assignes mtime from last git commit time to argument files
#
function fixMtime() {
	find "$@" -type f -exec bash -c 'commit_time=$(TZ=UTC0 git log -1 --format=tformat:%cd \
	--date=format:%Y-%m-%dT%H:%M:%SZ "$0"); [[ -n $commit_time ]] && \
	touch -md $commit_time "$0"' {} \;
}

#
# Selects only git-tracked files from arg1 array and stores them to arg2 array
#
function addGitFiles() {
	declare -n in_files=$1
	declare -n out_files=$2
	for file in "${in_files[@]}"; do
		while read -r gitFilePath; do
			if [[ -n "$gitFilePath" ]]; then
				out_files+=("$gitFilePath")
			fi
		done < <(git ls-files "$file")
	done
}

#
# Extracts top-level parent dir from folders in arg1 array
#
function getParentDirs() {
	declare -n in_folders=$1
	declare -n p_dir=$2
	for folder in "${in_folders[@]}"; do
		p_dir+=("${folder%%/*}")
	done
}

# makeself.sh /home/joe/mysoft mysoft.sh "Joe's Nice Software Package" ./setup
# e.g. makeself.sh [args] archive_dir file_name label startup_script [script_args]

VER=26.11
REPO_FILES=('LICENSE' 'pkg/makeself/install'
	'pkg/makeself/uninstall' 'xdg/applications/org.munadi.Munadi.desktop'
	'xdg/metainfo/org.munadi.Munadi.metainfo.xml')
REPO_FOLDERS=('xdg/icons/')

cd ../../

addGitFiles REPO_FILES FILES
addGitFiles REPO_FOLDERS FOLDERS
getParentDirs REPO_FOLDERS PARENTS

fixMtime "${FILES[@]}" "${FOLDERS[@]}"

trap 'rm -rf /tmp/files/' ERR EXIT ABRT INT QUIT SEGV TERM
mkdir -m 0755 /tmp/files/

cp --parents -prt /tmp/files/ "${FOLDERS[@]}"

shopt -s nullglob
for p in "${PARENTS[@]}"; do
	mv /tmp/files/$p/{.,}* /tmp/files/ || :
	rmdir /tmp/files/$p
done
shopt -u nullglob

cp -prt /tmp/files/ "${FILES[@]}" build/Release/munadi

find /tmp/files/ -depth -type d -exec sh -c 'touch -r "$0/$(ls -At "$0" | head -n1)" "$0"' {} \;

strip /tmp/files/munadi

cd - >/dev/null
makeself/makeself.sh \
	--header ./makeself-header.sh --sha256 --nomd5 \
	--zstd --complevel 22 --comp-extra "--row-match-finder --ultra --compress-literals" --threads 0 \
	--tar-format posix --tar-extra "
    --numeric-owner --owner 0 --group 0 --mode=go+u,go-w --posix 
		--pax-option=exthdr.name=%d/PaxHeaders/%f --pax-option=delete=atime,delete=ctime" \
	/tmp/files Munadi-${VER}.run "Munadi $VER Installer" ./install

exit 0

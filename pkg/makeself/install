#!/bin/bash

set -e
set -o pipefail

declare -i _debug=${APP_DEBUG:-0} # bool
declare -i _noask=0               # bool
declare -i _noexec=0              # bool
declare -i _noscript=0            # bool
declare -i _priv=0                # bool
declare -i _quiet=0               # bool
declare -i _sane=1                # bool
declare -i _verbose=0             # bool
((_debug)) && _verbose=1

_appname=Munadi
_orgname=munadi
_domain=org
_prog=munadi
_rdns=$_domain.$_orgname.$_appname
_script=install
_arch=x86_64
_errout=$(mktemp "${TMPROOT:-/tmp}/${_prog}-stderr.XXXXXX")
_logfile="$(mktemp -u ${TMPROOT:-/tmp}/${_prog}-$_script-XXXXXX).log"
_v_args=' -v '
_ver=26.11
_trapexec=('rm -f "$_errout"')

trap 'for handler in "${_trapexec[@]}"; do eval "$handler"; done' \
	ERR EXIT ABRT INT QUIT SEGV TERM

# Scratch file for command output (RAM-backed when possible), see run_logged()
_trapexec+=('rm -f "$_cmdout"')

dir=""
for dir in "${XDG_RUNTIME_DIR:-}" /dev/shm "${TMPROOT:-/tmp}"; do
	[[ -d "$dir" && -w "$dir" ]] && break
done

_cmdout=$(mktemp "$dir/${_prog}-cmd.XXXXXX")
unset -v dir

log() {
	echo -e "$(date --rfc-3339 ns):$_appname:$_script:$*" &>>"$_logfile"
}

debug_print() {
	if ((_debug)); then
		echo -e "\e[0;34m$_appname:$_script:debug::\t$*\e[0;m" >&2
	fi
	log "debug:: $*"
}

error_print() {
	if ((!_quiet)); then
		echo -e "\e[0;31m$_appname:$_script:error::\t$*\e[0;m" >&2
	fi
	log "error:: $*"
}

warn_print() {
	if ((!_quiet)); then
		echo -e "\e[0;33m$_appname:$_script:warn::\t$*\e[0;m" >&2
	fi
	log "warn:: $*"
}

info_print() {
	if ((_verbose)); then
		echo -e "$_appname:$_script:info::\t$*"
	fi
	log "info:: $*"
}

log_cmd() {
	local rc
	"$@" &>"$_cmdout" && rc=0 || rc=$?

	while IFS= read -r line || [[ -n $line ]]; do
		info_print "$line"
	done <"$_cmdout"

	return "$rc"
}

show_help() {
	echo "Usage:"
	echo "$_script [-h] [-nq] [-nv] [-qs] [-svy]"
	echo "$_script [--help] [--noexec --quiet] [--noexec --verbose] [--quiet --noscript] [--noscript --verbose --assumeyes]"
	echo
	echo Options:
	echo "  -h, --help        Shows this help message"
	echo "  -n, --noexec      Do not execute. Good for checking eligibility."
	echo "                    With '-s' do minimal checks only."
	echo "  -q, --quiet       Show less messages, even suppress usual output"
	echo "                    (implies -y)"
	echo
	echo "  -s, --noscript    Skip running pre- and post-$_script routines"
	echo "  -y, --assumeyes   Assume yes on confirmation"
	echo "  -v, --verbose     Show more messages. '-q' will have no effect"
	echo
	echo "  APP_DEBUG=1    Show debug messages. Implies '-v'"
	echo
}

_trapexec+=('warn_print "A log file is available at "$_logfile""')

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Flag parsing

while ((${#@})); do
	case "$1" in
	--assumeyes) _noask=1 ;;
	--help)
		show_help
		exit 0
		;;
	--noexec) _noexec=1 ;;
	--noscript) _noscript=1 ;;
	--quiet) _quiet=1 ;;
	--verbose) _verbose=1 ;;
	-*)
		OPTIND=1
		while getopts hnqsvy- opt; do
			case $opt in
			h)
				show_help
				exit 0
				;;
			n) _noexec=1 ;;
			q) _quiet=1 ;;
			s) _noscript=1 ;;
			v) _verbose=1 ;;
			y) _noask=1 ;;
			-) break ;;
			\?)
				show_help
				exit 1
				;;
			esac
		done
		;;
	*)
		error_print "illegal option: $1"
		show_help
		exit 1
		;;
	esac
	shift
done

((_quiet = _quiet & !_verbose)) || :
((_quiet | _noexec)) && _noask=1
#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Pre-install routines

# Do a pre-install check in case environment changed or because script is
# running standalone.

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Know what EUID and EGID we are. We don't accept normal users
# having system GID

declare -i _egid=$(id -g)
_ngid=$(id -gn)

debug_print 'Checking UID and GID...'
debug_print "Effective UID is $EUID ($USER)"
debug_print "Effective GID is $_egid ($_ngid)"
if ((EUID == 0)); then
	warn_print 'Script is running with superuser privilege.'
	_prefix=/opt/$_orgname/$_appname
	_priv=1
elif ((EUID >= 1000)) &&
	{ ((_egid >= 1000)) || [[ "$_ngid" = "users" ]]; }; then
	info_print 'Script is running with normal privilege.'
	_prefix=$HOME/.local
	_priv=0
else
	error_print 'Unusual effective IDs. Cowardly refusing to proceed.'
	_sane=0
fi
#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Test if required programs are available on the system
debug_print 'Checking if required programs are available...'
if hash chmod find install pkill rm rmdir sed uname \
	xdg-desktop-menu xdg-icon-resource 2>"$_errout"; then
	debug_print "\n$(hash -t chmod install pkill rm rmdir sed uname \
		xdg-desktop-menu xdg-icon-resource)"
else
	_sane=0
	error_print "\n$(<"$_errout")"
fi
_trapexec+=('hash -r')
#---------------------------------------------------

if ((!_noscript)); then
	#+++++++++++++++++++++++++++++++++++++++++++++++++++
	# Test if recommended dependenices are available on the system
	if hash dbus-send 2>/dev/null; then
		debug_print "dbus-send\t$(hash -t dbus-send)"
		if dbus-send --system --print-reply=literal \
			--dest=org.freedesktop.DBus \
			/ org.freedesktop.DBus.ListNames &>"$_errout"; then
			debug_print 'DBus system bus is operational.'
		else
			warn_print "No reply received. DBus system bus may not be operational."
			debug_print "$(<"$_errout")"
		fi

		if _out="$(dbus-send --session --dest=org.freedesktop.DBus \
			--type=method_call --print-reply=literal /org/freedesktop/DBus \
			org.freedesktop.DBus.NameHasOwner \
			string:'org.kde.StatusNotifierWatcher' 2>"$_errout")"; then
			debug_print 'DBus sesssion bus is operational.'
			if [[ "${_out##* }" == true ]]; then
				debug_print "org.kde.KStatusNotifierWatcher found."
			else
				warn_print "org.kde.KStatusNotifierWatcher DBus service not found."
				warn_print "Tray icon won't work."
			fi
		else
			warn_print 'No reply received. DBus session bus may not be operational.'
			debug_print "$(<"$_errout")"
		fi
	else
		warn_print '"dbus-send" not found, DBus may not be available.'
		warn_print "Some app features may not work."
	fi
	#---------------------------------------------------

	#+++++++++++++++++++++++++++++++++++++++++++++++++++
	# Ensure we have any form of wayland to display
	debug_print 'Checking if we have any form of wayland to display...'
	if [[ -n "$WAYLAND_DISPLAY" ]] && [[ "${XDG_SESSION_TYPE}" == "wayland" ]]; then
		debug_print "Wayland display socket found: $WAYLAND_DISPLAY"
		debug_print "XDG_SESSION_TYPE is $XDG_SESSION_TYPE"
	else
		error_print 'Wayland display not found.'
		debug_print "WAYLAND_DISPLAY=$WAYLAND_DISPLAY"
		debug_print "XDG_SESSION_TYPE=$XDG_SESSION_TYPE"
		if ((_priv)); then
			# We continue because the script may be running under 'sudo', 'su' or chroot
			# all for which the variables aren't usually available.
			error_print 'Continuing through previous error...'
		else
			_sane=0
		fi
	fi
	#---------------------------------------------------

	#+++++++++++++++++++++++++++++++++++++++++++++++++++
	# Check if required dynamic libraries are available on the system
	debug_print 'Checking required dynamic libraries...'
	if hash ldconfig 2>/dev/null; then
		debug_print 'Using ldconfig to search libraries'
		_syslibs=$(ldconfig -p 2>/dev/null | sed -n 's/.* => //p')
	else
		debug_print 'Searching required libraries in known paths...'
	fi

	# We currently check for lib basename, although older lib versions found may
	# potentially raise unexpected bugs.
	for lib in \
		libEGL.so.1 libOpenGL.so.0 libc.so.6 libdbus-1.so.3 \
		libgcc_s.so.1 libm.so.6 libstdc++.so.6 libwayland-client.so.0 \
		libwayland-cursor.so.0 libwayland-egl.so.1 libxkbcommon.so.0 libz.so.1 libzstd.so.1; do
		if [[ -z "$_syslibs" ]]; then
			_out="$(find -O3 -H /lib /lib64 /usr/lib /usr/lib64 \
				\( -type l -o -type f \) -iname "$lib*" -print -quit 2>/dev/null)" || :
			[[ -n "$_out" ]] && debug_print "$lib found at $_out" && continue

		else
			[[ "$_syslibs" == *"$lib"* ]] && debug_print "$lib found" && continue
		fi
		_sane=0
		error_print "$lib not found."
	done
	#---------------------------------------------------

	#+++++++++++++++++++++++++++++++++++++++++++++++++++
	# Ensure we're on a supported machine
	debug_print 'Checking machine architecture...'
	_machine="$(uname -m)"
	debug_print "Machine type is $_machine"
	if [[ "$_machine" != "$_arch" ]]; then
		_sane=0
		error_print "$_machine is not supported."
	fi
	#---------------------------------------------------
fi

# Exit if one or more sanity checks fail
if ((_sane)); then
	info_print 'All checks succeeded.'
	((_noexec)) && exit 0
else
	error_print 'Pre-check failed!'
	exit 1
fi

#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Confirmation before install

((_noscript)) && warn_print "Pre/post scripts won't be executed."

if ((!_noask)); then
	warn_print "$_appname $_ver will be ${_script}ed under $_prefix ."
	((_verbose)) || warn_print "Pass '--verbose' to see ${_script}ed files."

	_trapexec+=("unset REPLY")
	unset REPLY
	until [[ $REPLY == [yY] ]]; do
		read -ep 'Continue? [y/N]: '
		if [[ "$REPLY" == [nN] || -z "$REPLY" ]]; then
			warn_print "Aborting ${_script}ation. Nothing done."
			exit 0
		fi
	done
fi

#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Install routines

cd "${0%/*}"
debug_print "Saving program version to $_appname.version ..."
echo "_ver=$_ver" >./${_appname}.version
debug_print "$(<./${_appname}.version)"
_trapexec+=("rm -f ./${_appname}.version")

# ((_verbose)) && _v_args=' -v '
info_print "Installing $_appname $_ver under $_prefix ..."
debug_print 'Install phase in progress...'

debug_print "Changing mode of desktop file to 0755"
log_cmd chmod $_v_args 0755 ./$_rdns.desktop

debug_print "Attempting to uninstall previous installation"
hash -p "$_prefix/libexec/$_orgname/$_appname/uninstall" uninstall_old
debug_print "Invoking uninstall script $(hash -t uninstall_old)"
{ ((_verbose)) && _arg='--verbose'; } || _arg=''
uninstall_old --assumeyes $_arg --noscript --nocleanup &>$_errout || {
	debug_print "Previous uninstall script not found or some error occured."
	debug_print "Continuing without uninstalling."
}
info_print "\n$(<"$_errout")"

debug_print "====== BEGIN from $(hash -t install) ======"
# (( _debug )) && _v_args+=" --debug "   # Doesn't work on many systems
_trapexec+=('if (( $? )); then ./uninstall -qs; fi')
log_cmd install $_v_args -D --mode 0755 --strip ./$_prog --target "$_prefix/bin"
log_cmd install $_v_args -D --mode 0755 ./{,un}install --target "$_prefix/libexec/$_orgname/$_appname"
log_cmd install $_v_args -D --mode 0444 ./$_appname.version --target "$_prefix/libexec/$_orgname/$_appname"
log_cmd install $_v_args -D --mode 0644 ./LICENSE --target "$_prefix/share/licenses/$_orgname/$_appname"
if ((_priv)); then
	log_cmd install $_v_args -D --mode 0644 ./$_rdns.metainfo.xml --target "/usr/share/metainfo"
	log_cmd install $_v_args -D --mode 0644 \
		./icons/hicolor/scalable/apps/$_rdns-symbolic.svg \
		--target "/usr/share/icons/hicolor/scalable/apps"
	log_cmd install $_v_args -D --mode 0644 \
		./icons/hicolor/symbolic/apps/$_rdns-symbolic.svg \
		--target "/usr/share/icons/hicolor/symbolic/apps"
else
	log_cmd install $_v_args -D --mode 0644 ./$_rdns.metainfo.xml --target "$_prefix/share/metainfo"
	log_cmd install $_v_args -D --mode 0644 \
		./icons/hicolor/scalable/apps/$_rdns-symbolic.svg \
		--target "$_prefix/share/icons/hicolor/scalable/apps"
	log_cmd install $_v_args -D --mode 0644 \
		./icons/hicolor/symbolic/apps/$_rdns-symbolic.svg \
		--target "$_prefix/share/icons/hicolor/symbolic/apps"
fi
debug_print "======== END from $(hash -t install) ======"

unset -v XDG_DATA_DIRS
declare -x XDG_UTILS_DEBUG_LEVEL
_trapexec+=('unset -v XDG_UTILS_DEBUG_LEVEL')

((XDG_UTILS_DEBUG_LEVEL = _debug ? 3 : 2)) || :
sed -i -r "/^Exec/c\Exec=$_prefix/bin/$_prog" ./$_rdns.desktop
echo -e "\n[Desktop Action Remove]\nName=Uninstall $_appname\nExec=$_prefix/libexec/$_orgname/$_appname/uninstall" >>./$_rdns.desktop
log_cmd mv $_v_args ./$_rdns{,-sfx}.desktop
debug_print "====== BEGIN from $(hash -t xdg-desktop-menu) ======"
log_cmd xdg-desktop-menu install --novendor ./$_rdns-sfx.desktop
debug_print "======== END from $(hash -t xdg-desktop-menu) ======"
debug_print "====== BEGIN from $(hash -t xdg-icon-resource) ======"
for size in 16 22 24 32 36 48 64 72 80 96 128 192 256 480 512; do
	log_cmd xdg-icon-resource install --noupdate --novendor --size $size \
		./icons/hicolor/${size}x${size}/apps/$_rdns.png \
		$_rdns
done
log_cmd xdg-icon-resource forceupdate
debug_print "======== END from $(hash -t xdg-icon-resource) ======"
#---------------------------------------------------

#+++++++++++++++++++++++++++++++++++++++++++++++++++
# Post-install routines

if ((!_noscript)); then

	# Terminate all instances of the program
	((_verbose)) && _v_args=' --echo '
	debug_print "====== BEGIN from $(hash -t pkill) ======"
	log_cmd pkill $_v_args --exact --signal SIGTERM $_appname ||
		debug_print "No other instances of $_appname found." && :
	debug_print "======== END from $(hash -t pkill) ======"
fi
#---------------------------------------------------

warn_print "$_appname $_ver ${_script}ed successfully."

exit 0
